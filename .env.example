# ═══════════════════════════════════════════════════════════════════════════
# Mortgage AI Streaming Lab — variables de entorno
# Copia como .env y ajusta:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── Versiones ────────────────────────────────────────────────────────────
CONFLUENT_VERSION=7.6.13
MARQUEZ_VERSION=0.50.0
JDBC_CONNECTOR_VERSION=10.8.0

# ── Directorio de datos persistentes ────────────────────────────────────
DATA_DIR=./data

# ── Puertos ──────────────────────────────────────────────────────────────
KAFKA_EXTERNAL_PORT=9092
KAFKA_JMX_PORT=9101
SCHEMA_REGISTRY_PORT=8081
CONNECT_REST_PORT=8083
KAFKA_UI_PORT=8080
FLINK_UI_PORT=8082
POSTGRES_MORTGAGE_PORT=5433
MARQUEZ_API_PORT=5000
MARQUEZ_ADMIN_PORT=5001
MARQUEZ_WEB_PORT=3000
FRONTEND_PORT=5050
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ── Recursos (ajusta según tu hardware) ─────────────────────────────────
BROKER_MEMORY_LIMIT=2G
CONNECT_MEMORY_LIMIT=2G
SCHEMA_REGISTRY_MEMORY_LIMIT=1G
KAFKA_UI_MEMORY_LIMIT=512M
FLINK_JM_MEMORY_LIMIT=1G
FLINK_TM_MEMORY_LIMIT=2G
MARQUEZ_MEMORY_LIMIT=1G

KAFKA_HEAP_OPTS="-Xmx1g -Xms1g"
CONNECT_HEAP_OPTS="-Xmx1g -Xms512m"
KAFKA_LOG_RETENTION_BYTES=107374182400

# ── LLM para los agentes de IA (risk_agent / decision_agent) ───────────
# LLM_PROVIDER = "openai_compatible" (default) o "watsonx"
LLM_PROVIDER=watsonx

# ── Opción A: watsonx.ai ────────────────────────────────────────────────
# WATSONX_API_KEY es tu API key de IBM Cloud (NO el bearer token — el
# agente lo intercambia solo por un token IAM y lo renueva automáticamente).
# Créala en: https://cloud.ibm.com/iam/apikeys
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=15c734f6-7092-4a38-98a7-925551cd13ee
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct
WATSONX_VERSION=2023-05-29

# ── Opción B: cualquier endpoint compatible con /v1/chat/completions ───
# (OpenAI, Azure OpenAI vía gateway compatible, Ollama, LM Studio, etc.)
# Solo se usa si LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Ejemplo para usar un modelo local con Ollama en vez de un proveedor cloud
# (útil para hacer la demo sin salir a Internet):
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# ── Notificaciones por email (ai-email-notifier) ────────────────────────
# Por defecto apunta a Mailpit (servidor SMTP falso incluido en el stack,
# bandeja web en http://localhost:8025). Para usar un SMTP real, cambia
# estas variables (por ejemplo Gmail SMTP, SES, SendGrid SMTP, etc.) — el
# código del agente no cambia.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=River Bank <notificaciones@riverbank.demo>

# ── Iceberg sink hacia watsonx.data developer edition (opcional) ───────
# Ver docs/ICEBERG_WATSONX.md para el procedimiento completo (exponer HMS y
# MinIO de watsonx.data, obtener credenciales, compilar el conector).
# Déjalo en false hasta haber corrido scripts/build-iceberg-connector.sh y
# expuesto los puertos de watsonx.data.
ICEBERG_ENABLED=false
ICEBERG_NAMESPACE=mortgage

# HMS (Hive Metastore) de watsonx.data expuesto en el host vía
# 'kubectl port-forward svc/ibm-lh-mds-thrift-svc <puerto>:9083 --address 0.0.0.0'
ICEBERG_HMS_HOST=host.docker.internal
ICEBERG_HMS_PORT=9083

# MinIO S3 de watsonx.data expuesto en el host vía
# 'kubectl port-forward svc/ibm-lh-minio-svc <puerto>:9000 --address 0.0.0.0'
ICEBERG_S3_HOST=host.docker.internal
ICEBERG_S3_PORT=9000
ICEBERG_S3_ACCESS_KEY=
ICEBERG_S3_SECRET_KEY=
# Bucket ya existente en el MinIO de watsonx.data (créalo desde la consola
# de watsonx.data o con 'mc mb' antes de activar ICEBERG_ENABLED).
ICEBERG_BUCKET=mortgage-lab

# ── Proxy corporativo (opcional) ────────────────────────────────────────
# HTTP_PROXY=http://proxy.empresa.com:8080
# HTTPS_PROXY=http://proxy.empresa.com:8080
